# SellerPilot AI — Environment Variables Template
# Is file ko copy karke .env banao:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── API KEYS ─────────────────────────────────────────────────
# Anthropic Claude API Key (https://console.anthropic.com)
# sk-ant-... se shuru hoti hai
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Groq API Key (https://console.groq.com) — fast & free alternative
# gsk_... se shuru hoti hai
GROQ_API_KEY=your_groq_api_key_here

# ── ENVIRONMENT ───────────────────────────────────────────────
# development = mock Amazon data use hoga (safe for testing)
# production  = real Amazon SP-API se data aayega
ENVIRONMENT=development

# ── TWILIO WHATSAPP (Optional) ────────────────────────────────
# Low stock aur urgent alerts ke liye WhatsApp notifications
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
SELLER_WHATSAPP=whatsapp:+91XXXXXXXXXX
